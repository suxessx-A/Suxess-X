{
  "expo": {
    "name": "Amplify X Momentum",
    "slug": "amplify-x-momentum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amplify-x-momentum",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.amplify-x.momentum"
    },
    "android": {
      "package": "co.amplify_x.momentum"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      ["expo-router", { "origin": "https://momentum.amplify-x.co" }],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
