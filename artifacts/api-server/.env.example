# Required runtime
PORT=3000
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# OpenAI (coaching generation)
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Stripe (billing + webhook signature verification)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Magic-link auth (v1.2+)
# RESEND_API_KEY: from https://resend.com — sender domain must be verified
RESEND_API_KEY=re_...
# SESSION_SECRET: 32+ byte random string used to sign session JWTs.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# APP_DEEP_LINK_BASE: deep-link prefix the magic-link button opens on the
# device. Must match the iOS / Android app URL scheme.
APP_DEEP_LINK_BASE=amplifyx://verify
