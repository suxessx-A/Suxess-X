# node_modules — pnpm will reinstall fresh in the container
**/node_modules

# Build outputs — will be rebuilt
**/dist
**/build
**/.next
**/.expo
**/.turbo
**/.cache

# Git
.git
.gitignore

# Environment files — secrets come from Railway env vars
**/.env
**/.env.local
**/.env.*.local

# Logs
**/*.log
npm-debug.log*

# OS / IDE
**/.DS_Store
**/Thumbs.db
.vscode/
.idea/

# Tests / coverage
**/coverage
**/__tests__
**/test-results

# Docker files
.dockerignore
Dockerfile
